# =============================================================================
# sla-marketplace — environment
#
# Copy to .env, fill in, NEVER commit.
# =============================================================================

# Deployer / test wallet private key (0x-prefixed hex)
# Use a throwaway testnet wallet — NOT your main wallet
PRIVATE_KEY=

# Arc Testnet RPC
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.network

# Deployed contract addresses (filled in after deploy)
USDC_ADDRESS=0x3600000000000000000000000000000000000000
SERVICE_REGISTRY_ADDRESS=
PAY_PER_CALL_ADDRESS=

# ─── v4.2 additions ──────────────────────────────────────────────────────────

# Circle Modular Wallets — Passkey / ERC-4337 Smart Account
# Create in Circle Console → Keys → Client Keys (TEST_API_KEY:...)
VITE_CLIENT_KEY=
VITE_CLIENT_URL=https://modular-sdk.circle.com/v1/rpc/w3s/buidl

# Gateway Nanopayments — dual-rail (optional; ERC-20 fallback always active)
GATEWAY_BATCH_URL=
GATEWAY_BATCH_API_KEY=

# DePIN Oracle bot signing key (optional; needed to run the uptime oracle)
UPTIME_ORACLE_PRIVATE_KEY=

# Circle Standard Developer API Key (optional; needed for developer-controlled wallets / SCP)
CIRCLE_API_KEY=

# ─── Contract addresses (fill after deploy) ──────────────────────────────────
VITE_PAY_PER_CALL=
VITE_SERVICE_REGISTRY=
VITE_USDC_ADDRESS=0x3600000000000000000000000000000000000000
VITE_CHAIN_ID=5042002
VITE_FACILITATOR_ADDRESS=
