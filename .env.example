# =============================================================================
# CallGuard — environment
#
# Copy to .env, fill in, NEVER commit.
# Server-side code prefers UNPREFIXED names; VITE_* accepted as fallback
# wherever noted. NEVER put *_PRIVATE_KEY / *_SECRET in VITE_* vars.
# Active pair: v8 (ServiceRegistryV8 + PayPerCallV8). v7 stays deployed and
# read-only; its addresses are kept below only because V7Cleanup still writes.
# =============================================================================

# ─── Wallets (throwaway testnet keys ONLY) ────────────────────────────────────
PRIVATE_KEY=                  # deployer / test wallet (scripts)

# ─── Arc Testnet RPC (any one of these; first set wins) ───────────────────────
ARC_RPC_URL=https://rpc.testnet.arc.io
# ARC_TESTNET_RPC_URL=        # fallback alias
# RPC_URL=                    # last-resort alias
CHAIN_ID=5042002

# ─── Active v8 pair (server aliases; frontend uses VITE_* below) ───────────────
USDC_ADDRESS=0x3600000000000000000000000000000000000000
SERVICE_REGISTRY_V8=0x793028B6A1d1bdA063dC9dB5bC8930b856F512A3
PAY_PER_CALL_V8=0xedce61eF5be31DC22cEfE342692622A26919a7EF
SLA_KEEPER_V8=0xBe897043e4c21cFe9A6532e43542CA48EaD83CB7
# The API reads the dispute address under the name DISPUTE_V2; the value is V4.
DISPUTE_V2=0xECDb019F1E92Ad35324cc7bBDf1D56b9e70B305B
SLA_EVIDENCE_V2=0x64872c29A19dF8E471103d0708397BAb96A311FC
# SLA_UPTIME=                  # A8: availability claims (docs/V8_DEPLOYMENT.md §9)
# ARBITER_ADDRESS=
# APPEAL_ARBITER_ADDRESS=
# TREASURY_ADDRESS=
# ADMIN_ADDRESS=               # deploy only; defaults to the broadcaster

# ─── Retired v7 pair (read-only; no route reads these by default) ──────────────
# Kept for scripts that still target v7 and for the V7Cleanup panel.
# SERVICE_REGISTRY=0x9ca97010464e8e6de6e27cf25eae9b939fbd7333
# PAY_PER_CALL=0x5fb41dd22c44e1de08f37d98c2995a62d6220540

# ─── x402 / payments ──────────────────────────────────────────────────────────
FACILITATOR_ADDRESS=0x0E515aEd287a7b3d2D9F7911321d99826653Fbd8
SELLER_ADDRESS=0x9adEDa85604C205791B98B4C239b5625688a4ba5
FACILITATOR_PRIVATE_KEY=      # settles premium-report / energy-data (EIP-3009 nonce) + /api/call-service
SELLER_PRIVATE_KEY=           # auto-receipt fallback signer (PROVIDER_<id>_KEY wins)
FACILITATOR_ADMIN_TOKEN=      # x402-facilitator: gates /verify /settle /callService /nano/call /callguard-hook (503 if unset)
ALLOWED_ORIGINS=              # x402-facilitator CORS allowlist, comma-separated (empty = same-origin only)
# PROVIDER_1_KEY=             # per-provider receipt signer
# PROVIDER_1_WEBHOOK=         # provider webhook URL (notify-provider)

# ─── Webhook auth ─────────────────────────────────────────────────────────────
PROVIDER_WEBHOOK_SECRET=      # REQUIRED — sent as x-webhook-secret header
# AUTO_RECEIPT_SECRET=        # legacy alias

# ─── Nano-call (custodial demo endpoint) ──────────────────────────────────────
BUYER_PRIVATE_KEY=            # spends on every POST — keep server-side
NANO_API_KEY=                 # REQUIRED — POST /api/nano-call is disabled without it
# UPSTASH_REDIS_REST_URL=     # persistent rate limiting (else in-memory) and the /api/call-service idempotency store
# UPSTASH_REDIS_REST_TOKEN=
# CALL_SERVICE_IDEMPOTENCY=   # set to "enabled" to turn on the payment-safety store; enabled but misconfigured answers 503
# IDEMPOTENCY_KEY_PREFIX=     # optional, default callguard:idempotency:call-service:
# GATEWAY_BATCH_URL=          # Circle Gateway batching (optional)
# GATEWAY_BATCH_API_KEY=

# ─── Agents / oracles / integrations (optional) ───────────────────────────────
# AGENT_PRIVATE_KEY=
# AGENT_WALLET_ADDRESS=
# UPTIME_ORACLE_PRIVATE_KEY=  # DePIN oracle bot signing key
# CIRCLE_API_KEY=             # enables Circle refund relay in auto-receipt
# ARKREEN_API_URL=            # energy-data upstream (else simulated)
# RESEND_API_KEY=             # provider email notify (currently unused path)

# ─── Frontend (VITE_* ships in the bundle — public values only) ───────────────
VITE_USDC_ADDRESS=0x3600000000000000000000000000000000000000
VITE_CHAIN_ID=5042002
VITE_FACILITATOR_ADDRESS=0x0E515aEd287a7b3d2D9F7911321d99826653Fbd8
# v8 pair — production sets both; without them the app reads the retired v7 pair.
VITE_SERVICE_REGISTRY_V8=0x793028B6A1d1bdA063dC9dB5bC8930b856F512A3
VITE_PAY_PER_CALL_V8=0xedce61eF5be31DC22cEfE342692622A26919a7EF
VITE_SLA_KEEPER=0xBe897043e4c21cFe9A6532e43542CA48EaD83CB7
VITE_DISPUTE_V4=0xECDb019F1E92Ad35324cc7bBDf1D56b9e70B305B
# VITE_DISPUTE_V2=            # the API name above is DISPUTE_V2; this one is the browser copy
# VITE_DISPUTE_V3=            # retired; the legacy dispute section reads the pinned literal
# VITE_SLA_UPTIME=            # A8: enables the Availability panel write path
# VITE_SLA_PROVENANCE=        # B3b: enables attestor provenance in the Verify panel
# VITE_SLA_EVIDENCE=          # B3c: v1 evidence registry (zk-constraint claim lives here)
# VITE_SLA_EVIDENCE_V2=0x64872c29A19dF8E471103d0708397BAb96A311FC
# VITE_SUBGRAPH_URL=          # defaults to the live v8 Studio endpoint
# VITE_SUBGRAPH_URL=https://api.studio.thegraph.com/query/1763627/onur/1.0.0
# Legacy v7 pair: only the V7Cleanup panel still writes to it.
# VITE_SERVICE_REGISTRY=0x9ca97010464e8e6de6e27cf25eae9b939fbd7333
# VITE_PAY_PER_CALL=0x5fb41dd22c44e1de08f37d98c2995a62d6220540

# Circle Modular Wallets — Passkey / ERC-4337 (client key is publishable)
# VITE_CLIENT_KEY=
VITE_CLIENT_URL=https://modular-sdk.circle.com/v1/rpc/w3s/buidl
