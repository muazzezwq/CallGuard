# foundry
out/
cache/
broadcast/
!broadcast/*/dry-run/

# deps
lib/
!src/lib/
node_modules/

# env
.env
.env.*
!.env.example

# os
.DS_Store
*.log
.vercel
.env*

# build output — regenerated by vercel.json buildCommand (`bun run build`),
# served from outputDirectory dist. Not source.
dist/

# audit screenshots are evidence, not source: only the latest set is tracked.
docs/screenshots/*.png
docs/screenshots/panels/*.png

# agent tooling — local only, never shipped
.agents/
docs/superpowers/
skills-lock.json

# v8 subgraph generated output (regenerate with npm run codegen:v8 / build:v8)
subgraph/v8/generated/
subgraph/v8/build/
