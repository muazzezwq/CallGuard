{
  "outputDirectory": "dist",
  "buildCommand": "bun run build",
  "installCommand": "bun install --frozen-lockfile",
  "framework": null,
  "functions": {
    "api/auto-receipt.js":      { "maxDuration": 25 },
    "api/call-service.js":      { "maxDuration": 25 },
    "api/notify-provider.js":   { "maxDuration": 15 },
    "api/attestation.js":       { "maxDuration": 30 },
    "api/marketplace.js":       { "maxDuration": 10 },
    "api/unified-balance.js":   { "maxDuration": 10 },
    "api/nano-call.js":         { "maxDuration": 15 },
    "api/energy-data.js":       { "maxDuration": 10 },
    "api/ping-provider.js":     { "maxDuration": 10 },
    "api/premium-report.js":    { "maxDuration": 15 },
    "api/provider-page.js":     { "maxDuration": 15 },
    "api/widget.js":            { "maxDuration": 10 }
  },
  "rewrites": [
    { "source": "/callService",       "destination": "/api/call-service" },
    { "source": "/nano/call",         "destination": "/api/nano-call" },
    { "source": "/nano/balance",      "destination": "/api/nano-call?balance=1" },
    { "source": "/sitemap.xml",       "destination": "/api/provider-page?sitemap=1" },
    { "source": "/providers/:id",     "destination": "/api/provider-page?id=:id" },
    { "source": "/(.*)",              "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin",  "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET,POST,OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type,X-Payment,X-Machine-Id,Authorization" }
      ]
    },
    {
      "source": "/((?!api/).*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy",        "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy",     "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "X-Frame-Options",        "value": "DENY" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'none'" }
      ]
    }
  ]
}
