{
  "version": 2,
  "builds": [
    {
      "src": "demo/index.html",
      "use": "@vercel/static"
    },
    {
      "src": "demo/app/index.html",
      "use": "@vercel/static"
    },
    {
      "src": "api/*.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/app(.*)", "dest": "/demo/app/index.html" },
    { "src": "/(.*)", "dest": "/demo/$1" }
  ]
}
