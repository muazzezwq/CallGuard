{
  "outputDirectory": "dist",
  "buildCommand": "bun run build",
  "framework": null,
  "functions": {
    "api/auto-receipt.js":   { "maxDuration": 25 },
    "api/call-service.js":   { "maxDuration": 25 },
    "api/notify-provider.js":{ "maxDuration": 15 },
    "api/attestation.js":    { "maxDuration": 30 }
  },
  "redirects": [
    { "source": "/app",  "destination": "/", "permanent": false },
    { "source": "/app/", "destination": "/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/callService",       "destination": "/api/call-service" },
    { "source": "/nano/call",         "destination": "/api/nano-call" },
    { "source": "/nano/balance",      "destination": "/api/nano-balance" },
    { "source": "/sitemap.xml",       "destination": "/api/provider-page?sitemap=1" },
    { "source": "/providers/:id",     "destination": "/api/provider-page?id=:id" },
    { "source": "/(.*)",              "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin",  "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET,POST,OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type,X-Payment,X-Machine-Id,Authorization" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
