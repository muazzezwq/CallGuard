pragma solidity ^0.8.24;

/// @title IEIP5564Announcer
/// @notice Minimal interface for the EIP-5564 stealth address announcer.
///         Implementations emit Announcement events so that recipients can
///         scan for incoming stealth payments without exposing their identity.
///
/// @dev    EIP-5564 defines a standard for stealth address generation and
///         scanning. The announcer contract is a singleton that stores no
///         state — it only emits events. PayPerCall calls `announce()` in
///         `callServiceStealth()` so that the intended recipient (the owner
///         of `stealthAddress`) can discover the payment by scanning logs.
///
///         schemeId 1 = SECP256K1 ECDH (the most common scheme).
///
/// @custom:eip https://eips.ethereum.org/EIPS/eip-5564
interface IEIP5564Announcer {
    /// @notice Emitted when a stealth payment announcement is made.
    /// @param schemeId        Identifier for the stealth address scheme (1 = SECP256K1 ECDH).
    /// @param stealthAddress  The one-time stealth address that received the payment.
    /// @param caller          The sender who broadcast the announcement.
    /// @param ephemeralPubKey Ephemeral public key generated by the sender (65 bytes uncompressed
    ///                        or 33 bytes compressed, scheme-dependent).
    /// @param metadata        Optional scheme-specific metadata (e.g. view-tag byte, scheme tag).
    event Announcement(
        uint256 indexed schemeId,
        address indexed stealthAddress,
        address indexed caller,
        bytes ephemeralPubKey,
        bytes metadata
    );

    /// @notice Broadcast a stealth payment announcement.
    /// @param schemeId        Stealth address scheme identifier (1 = SECP256K1 ECDH).
    /// @param stealthAddress  One-time address the payment was sent to.
    /// @param ephemeralPubKey Ephemeral public key (65 bytes uncompressed for scheme 1).
    /// @param metadata        Scheme-specific metadata blob.
    function announce(
        uint256 schemeId,
        address stealthAddress,
        bytes calldata ephemeralPubKey,
        bytes calldata metadata
    ) external;
}
